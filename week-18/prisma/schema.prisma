datasource db {
  provider = "postgresql"
  url      = "postgresql://neondb_owner:npg_WGV75MHnaJSc@ep-wild-pine-adokmoa9-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
